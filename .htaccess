# Matri Seva Samiti NGO Website - Modern .htaccess

# Set default index file
DirectoryIndex index.php index.html

# Prevent access to sensitive files (Apache 2.2 & 2.4 compatible)
<FilesMatch "^\.(htaccess|htpasswd|ini|log|sql|conf|git|env)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# URL Rewriting
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Allow direct access to existing files and directories
    RewriteCond %{REQUEST_FILENAME} -d [OR]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Map extensionless URLs to .php files if they exist
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([^/]+)/?$ $1.php [L,QSA]
</IfModule>