<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent loop if already rewritten to public
    RewriteCond %{REQUEST_URI} ^/public/ [NC]
    RewriteRule ^ - [L]

    # Allow direct access to legacy website directories if DocumentRoot is root
    RewriteCond %{REQUEST_URI} ^/(perviouswebsite|previouswebsite) [NC]
    RewriteCond %{REQUEST_FILENAME} -d [OR]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Route all other requests to public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>